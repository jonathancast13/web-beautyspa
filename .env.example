# ============================================================
# Copia este archivo como .env.local y rellena los valores.
#   cp .env.example .env.local
# ============================================================

# --- WhatsApp (Meta Cloud API) ---
# Número del chatbot: dígitos con prefijo de país, sin "+" (ej: 34600111222)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Token de acceso de la API de WhatsApp (Meta App > WhatsApp > API setup)
WHATSAPP_TOKEN=
# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_ID=
# Texto libre que tú eliges; debe coincidir con el configurado en Meta
WHATSAPP_VERIFY_TOKEN=destellos-verificacion
# Secreto de la app de Meta, para verificar la firma de los webhooks
WHATSAPP_APP_SECRET=

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar (cuenta de servicio) ---
# Email de la cuenta de servicio creada en Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada PEM (en Vercel: pega el PEM real y sustuye \n por saltos de línea)
GOOGLE_PRIVATE_KEY=
# ID del calendario que será la fuente de verdad (pestaña "Integración de calendario")
GOOGLE_CALENDAR_ID=
